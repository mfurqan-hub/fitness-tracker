# ============================================================
# FitPulse Fitness Tracker — Server Environment Configuration
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB — Required for persistent data storage.
MONGODB_URI=mongodb://127.0.0.1:27017/fitness_tracker

# JWT — Required. Use a long random string (min 32 chars) for production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRE=30d

# Frontend URL (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# === FIREBASE ADMIN SDK CONFIGURATION ===
# Obtain from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# === SMTP NODEMAILER EMAIL CONFIGURATION ===
# Standard SMTP credentials for email verification, welcome emails, and password resets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password
MAIL_FROM="FitPulse <no-reply@fitnesstracker.com>"

# === DEVELOPMENT/DEMO ONLY ===
# Set to true ONLY if MongoDB is not installed locally.
# MONGODB_USE_MEMORY_SERVER=true
